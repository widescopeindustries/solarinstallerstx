# Solar Installers TX - Environment Variables
# Copy this file to .env and fill in your actual values

# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: SERVICE_ROLE_KEY should ONLY be used in server-side scripts
# NEVER expose this in the browser - only use in scripts/ directory
# For frontend, use ANON_KEY only
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mapbox Configuration
# Get from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your-mapbox-token-here

# Google Places API (for server-side Supabase functions only)
# Do NOT add VITE_ prefix - this is server-only
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# Stripe Configuration
# Get from: https://dashboard.stripe.com/test/apikeys
# IMPORTANT: Use TEST MODE keys for development (pk_test_, sk_test_)
# Switch to LIVE MODE keys only when ready for production (pk_live_, sk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-secret-key-here

# Stripe Price IDs for subscription tiers
# Create products at: https://dashboard.stripe.com/test/products
# Set each as "Recurring" with "Monthly" billing period
VITE_STRIPE_PRICE_BASIC=price_your-basic-99-monthly
VITE_STRIPE_PRICE_PREMIUM=price_your-premium-199-monthly
VITE_STRIPE_PRICE_ENTERPRISE=price_your-enterprise-399-monthly

# Notes:
# - All variables with VITE_ prefix are exposed to the browser
# - Keep .env file private and never commit to git
# - Restart dev server after changing .env
# - Use import.meta.env.VITE_* to access in code (NOT process.env)
