# Solar Installers TX - Environment Variables for Next.js
# Copy this file to .env.local and fill in your actual values

# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: SERVICE_ROLE_KEY should ONLY be used in server-side code
# NEVER expose this in the browser - only use in Server Components/API Routes
# For client-side, use ANON_KEY only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mapbox Configuration
# Get from: https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token-here

# Google Places API (for server-side operations only)
# Do NOT add NEXT_PUBLIC_ prefix - this is server-only
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# Notes:
# - All variables with NEXT_PUBLIC_ prefix are exposed to the browser
# - Keep .env.local file private and never commit to git
# - Restart dev server after changing .env.local
# - Use process.env.NEXT_PUBLIC_* to access in code (NOT import.meta.env)
# - In Next.js, client components use process.env, server components can access all vars
