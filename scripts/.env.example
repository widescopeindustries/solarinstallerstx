# Email Outreach Scripts - Environment Variables
# Copy this file to .env and fill in your credentials

# SMTP Configuration (for email_sender.py)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
FROM_EMAIL=your-email@gmail.com
FROM_NAME=Michael Lyndon

# For Gmail users:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Generate an "App Password" (not your regular password)
# 3. Use that 16-character password in SMTP_PASSWORD

# For other email providers:
# - Outlook: smtp.office365.com, port 587
# - Yahoo: smtp.mail.yahoo.com, port 587
# - Custom domain: Contact your email host for SMTP settings
