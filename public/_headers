# Set a default caching policy for all files
/*
  Cache-Control: public, max-age=0, must-revalidate

# Aggressively cache immutable hashed assets (JS, CSS with hashes)
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Cache images for 1 year (they have hashes)
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Cache fonts for 1 year
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Cache other assets for 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache static JSON data for 1 day
/installers.json
  Cache-Control: public, max-age=86400, must-revalidate

# Cache service worker and manifest for 1 hour, revalidating on each visit
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
  
# Security Headers - Apply to all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
