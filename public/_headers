# Set a default caching policy for all files
/*
  Cache-Control: public, max-age=0, must-revalidate

# Aggressively cache immutable assets (fonts, images, videos, etc.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache service worker and manifest for 1 hour, revalidating on each visit
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=3600, must-revalidate
  
# Security Headers - Apply to all pages
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
